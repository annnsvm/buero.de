# --- Local development ---
# Use Render External Database URL (Dashboard → PostgreSQL → External).
# Add ?schema=public&sslmode=require for local connections.
DATABASE_URL="postgresql://USER:PASSWORD@dpg-XXXX.oregon-postgres.render.com/buro_de?schema=public&sslmode=require"
NODE_ENV="development"
PORT=3000

# Auth / JWT
JWT_ACCESS_SECRET="your-access-secret-min-32-chars"
JWT_REFRESH_SECRET="your-refresh-secret-min-32-chars"
JWT_ACCESS_EXPIRES_IN="30m"
JWT_REFRESH_EXPIRES_IN="7d"

# Cookie / CORS — local frontend (Vite)
COOKIE_DOMAIN=""
COOKIE_SECURE="false"
CORS_ORIGIN="http://localhost:5173"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_ID="price_..."
STRIPE_PORTAL_RETURN_URL="http://localhost:5173/settings/billing"

TRIAL_DAYS=7

# Rate limiting (Throttler)
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Cloudinary (course covers) — https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Production on Render (Web Service buro-de) ---
# DATABASE_URL  = Internal Database URL (not External)
# NODE_ENV      = production
# CORS_ORIGIN   = https://www.buro-de.com
# COOKIE_SECURE = true
# STRIPE_PORTAL_RETURN_URL = https://www.buro-de.com/settings/billing

# E2E (Jest): set automatically in test/setup-e2e-env.ts
# E2E_TEST=true
